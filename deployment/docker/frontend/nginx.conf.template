server {
    listen 8080;
    root /usr/share/nginx/html;

    location / {
        try_files $uri /index.html;
    }

    # Запросы к API идут через тот же адрес, что и страница, поэтому CORS не нужен
    location /api/ {
        # Host остаётся именем сервиса API: по нему sidecar Istio находит маршрут, в том числе canary
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header X-Request-Id $request_id;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
