# Loki в одном экземпляре (SingleBinary): для одного кластера этого достаточно, чанки хранятся в S3
deploymentMode: SingleBinary
loki:
  # Образы из зеркала в GHCR, см. .github/workflows/mirror-images.yml
  image:
    registry: ghcr.io
    repository: alexxkn/credit-scoring-mlops/mirror/grafana/loki
    tag: 3.6.11
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  schemaConfig:
    configs:
      - from: "2026-01-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: index_
          period: 24h
  storage:
    type: s3
    bucketNames:
      chunks: ${bucket}
      ruler: ${bucket}
    s3:
      endpoint: ${s3_endpoint}
      region: ru-msk
      accessKeyId: ${s3_access_key}
      secretAccessKey: ${s3_secret_key}
      s3ForcePathStyle: false
  limits_config:
    retention_period: 168h
  compactor:
    retention_enabled: true
    delete_request_store: s3
  # Правила алертов по логам читаются из ConfigMap, а не из S3
  rulerConfig:
    storage:
      type: local
      local:
        directory: /etc/loki/rules
    alertmanager_url: http://kube-prometheus-stack-alertmanager.${namespace}.svc:9093
    enable_api: true
    ring:
      kvstore:
        store: inmemory

singleBinary:
  replicas: 1
  nodeSelector: ${system_node_selector}
  persistence:
    storageClass: csi-ceph-ssd
    size: 10Gi
  resources:
    requests: {cpu: 200m, memory: 512Mi}
    limits: {memory: 2Gi}

ruler:
  directories:
    fake:
      credit-scoring.yaml: |
        ${indent(8, log_rules)}

gateway:
  nodeSelector: ${system_node_selector}
  image:
    registry: ghcr.io
    repository: alexxkn/credit-scoring-mlops/mirror/nginxinc/nginx-unprivileged
    tag: 1.29-alpine

read: {replicas: 0}
write: {replicas: 0}
backend: {replicas: 0}
chunksCache: {enabled: false}
resultsCache: {enabled: false}
lokiCanary: {enabled: false}
test: {enabled: false}
minio: {enabled: false}
