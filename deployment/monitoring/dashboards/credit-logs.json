{
 "uid": "credit-logs",
 "title": "Credit Scoring: логи",
 "tags": [
  "credit-scoring"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Логи по уровням",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (level) (count_over_time({app=~\"credit-scoring-api.*\", namespace=\"$namespace\", container=\"api\"}[1m]))",
     "legendFormat": "{{level}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Задержка по логам, p95",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "quantile_over_time(0.95, {app=~\"credit-scoring-api.*\", namespace=\"$namespace\", container=\"api\"} | json | path=\"/predict\" | unwrap duration_ms | __error__=\"\" [5m]) by (namespace)",
     "legendFormat": "p95, мс",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 2
  },
  {
   "type": "logs",
   "title": "Ошибки и предупреждения",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{app=~\"credit-scoring-api.*\", namespace=\"$namespace\", container=\"api\", level=~\"ERROR|WARNING|CRITICAL\"}",
     "legendFormat": "",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "id": 3
  },
  {
   "type": "logs",
   "title": "Все логи API",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 12
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{app=~\"credit-scoring-api.*\", namespace=\"$namespace\", container=\"api\"}",
     "legendFormat": "",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending"
   },
   "id": 4
  }
 ],
 "templating": {
  "list": [
   {
    "name": "ds_uid",
    "type": "datasource",
    "query": "prometheus",
    "hide": 2,
    "current": {
     "text": "Prometheus",
     "value": "prometheus"
    }
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds_uid}"
    },
    "query": "label_values(credit_api_requests_total, namespace)",
    "refresh": 2,
    "current": {
     "text": "credit-scoring-prod",
     "value": "credit-scoring-prod"
    }
   }
  ]
 }
}