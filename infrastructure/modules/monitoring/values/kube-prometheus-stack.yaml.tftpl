# Prometheus, Alertmanager, Grafana, node-exporter и kube-state-metrics. Тяжёлые компоненты на группе узлов system
prometheus:
  prometheusSpec:
    retention: 7d
    # ServiceMonitor, PodMonitor и PrometheusRule подхватываются из всех namespace, без меток релиза
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    nodeSelector: ${system_node_selector}
    resources:
      requests: {cpu: 300m, memory: 1Gi}
      limits: {memory: 3Gi}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: csi-ceph-ssd
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: 20Gi

alertmanager:
  alertmanagerSpec:
    nodeSelector: ${system_node_selector}
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: telegram
      group_by: [alertname, namespace, severity]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        # Служебный алерт "Prometheus жив" в Telegram не шлём
        - receiver: "null"
          matchers: ['alertname = "Watchdog"']
        - receiver: "null"
          matchers: ['alertname = "InfoInhibitor"']
    inhibit_rules:
      - source_matchers: ['severity = "critical"']
        target_matchers: ['severity = "warning"']
        equal: [alertname, namespace]
    receivers:
      - name: "null"
      - name: telegram
        telegram_configs:
          - bot_token: "${telegram_bot_token}"
            chat_id: ${telegram_chat_id}
            parse_mode: HTML
            send_resolved: true
            message: |-
              {{ if eq .Status "firing" }}🔥{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> [{{ .CommonLabels.severity }}]
              {{ range .Alerts }}{{ .Annotations.summary }}
              {{ if .Annotations.runbook_url }}Runbook: {{ .Annotations.runbook_url }}{{ end }}
              {{ end }}

grafana:
  # Образ из зеркала в GHCR: Docker Hub из VK Cloud отдаёт большие образы слишком медленно
  image:
    registry: ghcr.io
    repository: alexxkn/credit-scoring-mlops/mirror/grafana/grafana
    tag: 13.3.1-distroless
  adminPassword: "${grafana_admin_password}"
  nodeSelector: ${system_node_selector}
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL
  additionalDataSources:
    - name: Loki
      type: loki
      uid: loki
      url: http://loki-gateway.${namespace}.svc
      access: proxy

kube-state-metrics:
  nodeSelector: ${system_node_selector}

prometheusOperator:
  nodeSelector: ${system_node_selector}

additionalPrometheusRulesMap:
  credit-scoring:
    groups:
      ${indent(6, rules)}
