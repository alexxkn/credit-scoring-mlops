{
 "uid": "credit-drift",
 "title": "Credit Scoring: дрифт и качество модели",
 "tags": [
  "credit-scoring"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Доля признаков с дрифтом",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_data_drift_share)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Дрифт вероятностей",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_prediction_drift_score)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "ROC-AUC на ответах",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_model_roc_auc_current)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.72
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Падение ROC-AUC",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_model_performance_decay)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Нужно переобучение",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_retrain_recommended)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "Последняя проверка",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_drift_last_run_timestamp) * 1000",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dateTimeFromNow"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "id": 6
  },
  {
   "type": "bargauge",
   "title": "Дрифт по признакам (Evidently)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (feature) (credit_feature_drift_score)",
     "legendFormat": "{{feature}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "displayMode": "gradient"
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Дрифт во времени",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_data_drift_share)",
     "legendFormat": "доля признаков",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    },
    {
     "refId": "B",
     "expr": "max(credit_prediction_drift_score)",
     "legendFormat": "вероятности",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Качество на размеченных ответах",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds_uid}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(credit_model_roc_auc_current)",
     "legendFormat": "ROC-AUC",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    },
    {
     "refId": "B",
     "expr": "max(credit_model_performance_decay)",
     "legendFormat": "падение к тесту",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds_uid}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 9
  }
 ],
 "templating": {
  "list": [
   {
    "name": "ds_uid",
    "type": "datasource",
    "query": "prometheus",
    "hide": 2,
    "current": {
     "text": "Prometheus",
     "value": "prometheus"
    }
   }
  ]
 }
}